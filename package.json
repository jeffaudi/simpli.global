{
  "name": "learn-simpli",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check:translations": "node scripts/check-translations.mjs",
    "build": "npm run check:translations && astro build",
    "build:spec-pdf": "python3 scripts/build-spec-pdf.py",
    "preview": "astro preview",
    "vocab:5000:bootstrap": "node --import tsx/esm scripts/bootstrap-vocab-5000-json.mjs",
    "vocab:5000:i18n": "node scripts/generate-vocab-5000-i18n.mjs",
    "vocab:5000:i18n:fr": "node scripts/generate-vocab-5000-i18n.mjs --locale fr",
    "vocab:5000:i18n:es": "node scripts/generate-vocab-5000-i18n.mjs --locale es",
    "vocab:5000:i18n:id": "node scripts/generate-vocab-5000-i18n.mjs --locale id",
    "vocab:5000:i18n:asian": "node scripts/generate-vocab-5000-i18n.mjs --locale all-asian",
    "i18n:ui": "node scripts/generate-ui-translations.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "astro": "^5.0.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "popular-english-words": "^1.0.2"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
