# Copy to `.env` for local builds. Values are baked in at build time (PUBLIC_*).

# Discord server invite (full URL). Leave empty to show “planned” + contact fallback.
PUBLIC_DISCORD_INVITE_URL=

# Optional forum URL (Discourse, GitHub Discussions, etc.).
PUBLIC_FORUM_URL=

# Shown when Discord/forum links are not set — lets visitors reach maintainers.
PUBLIC_CONTACT_EMAIL=
