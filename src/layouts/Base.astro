---
// Base layout – Astro i18n Starter theme adapted for Simpli
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import LocaleHtmlHead from '@/components/i18n/LocaleHtmlHead.astro';
import LocaleSuggest from '@/components/i18n/LocaleSuggest.astro';
import { getTranslations } from '@/lib/translations';
import { LOCALES, getLocalePaths, type Lang } from '@/i18n';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang: propLang } = Astro.props;
const rawLocale = propLang ?? Astro.params?.locale ?? Astro.params?.lang ?? Astro.currentLocale ?? 'en';
const locale = (typeof rawLocale === 'string' && rawLocale in LOCALES ? rawLocale : 'en') as Lang;
const tJson = getTranslations(locale) as {
  seo: { title: string; description: string; lead: string };
};

const localeTitle = title ? `${title} – ${tJson.seo.title}` : tJson.seo.title;
const localeDescription = description
  ? `${tJson.seo.lead} ${description}`
  : tJson.seo.description;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
---

<html lang={LOCALES[locale]?.lang || locale} dir={LOCALES[locale]?.dir || null}>
  <head>
    <meta charset="UTF-8" />
    <title>{localeTitle}</title>
    <meta name="description" content={localeDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={localeTitle} />
    <meta property="og:description" content={localeDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={tJson.seo.title} />
    <meta property="og:locale" content={LOCALES[locale]?.lang ?? locale} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={localeTitle} />
    <meta name="twitter:description" content={localeDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {
      getLocalePaths(Astro.url).map((props) => {
        const loc = LOCALES[props.lang];
        return (
          <link
            rel="alternate"
            hreflang={loc?.lang ?? props.lang}
            href={Astro.site?.origin + props.path}
          />
        );
      })
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp&display=swap"
    />
    <LocaleHtmlHead />
  </head>
  <body>
    <LocaleSuggest />
    <Header t={tJson} />
    <main class="l-main l-content">
      <slot />
    </main>
    <Footer t={tJson} locale={locale} />
    {import.meta.env.DEV && (
      <style is:global>:root { scroll-behavior: auto }</style>
    )}
  </body>
</html>
