---
// Base layout – Astro i18n Starter theme adapted for Simpli
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import LocaleHtmlHead from '@/components/i18n/LocaleHtmlHead.astro';
import LocaleSuggest from '@/components/i18n/LocaleSuggest.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts';
import { useTranslations, LOCALES, getLocalePaths, type Lang } from '@/i18n';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang: propLang } = Astro.props;
const rawLocale = propLang ?? Astro.params?.locale ?? Astro.params?.lang ?? Astro.currentLocale ?? 'en';
const locale = (typeof rawLocale === 'string' && rawLocale in LOCALES ? rawLocale : 'en') as Lang;
const t = useTranslations(locale);
const tJson = (await import(`../translations/${locale}.json`)).default as Record<string, unknown>;

const localeTitle = title ? `${title} – ${t(SITE_TITLE)}` : t(SITE_TITLE);
const localeDescription = description || t(SITE_DESCRIPTION);
---

<html lang={LOCALES[locale]?.lang || locale} dir={LOCALES[locale]?.dir || null}>
  <head>
    <meta charset="UTF-8" />
    <title>{localeTitle}</title>
    <meta name="description" content={localeDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {
      getLocalePaths(Astro.url).map((props) => {
        const loc = LOCALES[props.lang];
        return (
          <link
            rel="alternate"
            hreflang={loc?.lang ?? props.lang}
            href={Astro.site?.origin + props.path}
          />
        );
      })
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp&display=swap"
    />
    <LocaleHtmlHead />
  </head>
  <body>
    <LocaleSuggest />
    <Header t={tJson} siteTitle={t(SITE_TITLE)} />
    <main class="l-main l-content">
      <slot />
    </main>
    <Footer t={tJson} siteTitle={t(SITE_TITLE)} />
    {import.meta.env.DEV && (
      <style is:global>:root { scroll-behavior: auto }</style>
    )}
  </body>
</html>
