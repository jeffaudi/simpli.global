---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { essentialWords } from '@/data/essential-words';
const lang = 'es';
const t = (await import('../../translations/es.json')).default;
const categories = ['pronouns', 'numbers', 'verbs', 'people', 'nature', 'objects', 'adjectives', 'connectors'] as const;
---

<Layout lang={lang} title="Palabras esenciales" description="Vocabulario central Simpli por categoría.">
  <h1>{t.essentialWordsPage.h1}</h1>
  <p>{t.essentialWordsPage.intro}</p>
  {
    categories.map((cat) => (
      <section>
        <h2>{t.words[cat]}</h2>
        {cat === 'pronouns' ? (
          <>
            <p class="word-list">{essentialWords[cat].join(' · ')}</p>
            <p class="word-note"><strong>el</strong> = he, she o it (una sola palabra para toda la 3.ª persona del singular; no hay « it » separado).</p>
          </>
        ) : (
          <p class="word-list">{essentialWords[cat].join(' · ')}</p>
        )}
      </section>
    ))
  }
  <p><a href={getRelativeLocaleUrl(lang, 'vocabulary')}>{t.essentialWordsPage.backToVocabulary}</a></p>
</Layout>

<style>
  .word-list { font-family: ui-monospace, monospace; font-size: 0.95rem; line-height: 1.8; }
  .word-note { font-size: 0.9rem; color: var(--color-text-muted, #555); margin-top: 0.25em; }
</style>
