---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { essentialWords } from '@/data/essential-words';
const lang = 'es';
const t = (await import('../../translations/es.json')).default;
const categories = ['pronouns', 'numbers', 'verbs', 'people', 'nature', 'objects', 'adjectives', 'connectors'] as const;
---

<Layout lang={lang} title="Essential words" description="Simpli core vocabulary by category.">
  <h1>Essential words</h1>
  <p>Core Simpli vocabulary (~300 words).</p>
  {
    categories.map((cat) => (
      <section>
        <h2>{t.words[cat]}</h2>
        <p class="word-list">{essentialWords[cat].join(' · ')}</p>
      </section>
    ))
  }
  <p><a href={getRelativeLocaleUrl(lang, 'vocabulary')}>← Vocabulary overview</a></p>
</Layout>

<style>
  .word-list { font-family: ui-monospace, monospace; font-size: 0.95rem; line-height: 1.8; }
</style>
