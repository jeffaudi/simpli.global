---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = 'es';
const t = (await import('../../translations/es.json')).default;
const gr = t.grammarRulesPage;
---

<Layout lang={lang} title={gr.metaTitle} description={gr.metaDescription}>
  <h1>{gr.h1}</h1>
  <p>{gr.intro}</p>
  <h2>{gr.sectionPronounsTitle}</h2>
  <p set:html={gr.sectionPronounsBody} />
  <h2>{gr.sectionWordOrderTitle}</h2>
  <p set:html={gr.sectionWordOrderBody} />
  <h2>{gr.sectionVerbsTitle}</h2>
  <p set:html={gr.sectionVerbsBody} />
  <h2>{gr.sectionNegationTitle}</h2>
  <p set:html={gr.sectionNegationBody} />
  <h2>{gr.sectionQuestionsTitle}</h2>
  <p set:html={gr.sectionQuestionsBody} />
  <h2>{gr.sectionPluralTitle}</h2>
  <p set:html={gr.sectionPluralBody} />
  <h2>{gr.sectionArticlesTitle}</h2>
  <p set:html={gr.sectionArticlesBody} />
  <h2>{gr.sectionAdjectivesTitle}</h2>
  <p set:html={gr.sectionAdjectivesBody} />
  <h2>{gr.sectionPossessionTitle}</h2>
  <p set:html={gr.sectionPossessionBody} />
  <h2>{gr.sectionPrepositionsTitle}</h2>
  <p set:html={gr.sectionPrepositionsBody} />
  <h2>{gr.sectionConnectorsTitle}</h2>
  <p set:html={gr.sectionConnectorsBody} />
  <h2>{gr.sectionCompoundsTitle}</h2>
  <p set:html={gr.sectionCompoundsBody} />
  <h2>{t.grammarNumbers.h2}</h2>
  <p>{t.grammarNumbers.intro}</p>
  <p>34 → <strong>tri ten for</strong> ({t.grammarNumbers.ex34Paren})</p>
  <p>3253 → <strong>tri dausand tu hundrad faiv ten tri</strong> ({t.grammarNumbers.ex3253Paren})</p>
  <p>{t.grammarNumbers.digits}</p>
  <p><a href={getRelativeLocaleUrl(lang, 'grammar')}>{gr.backToGrammarOverview}</a></p>
</Layout>
