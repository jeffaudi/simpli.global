---
import Layout from '@/layouts/Base.astro';
import vocabulary1500Es from '@/data/vocabulary-1500.es.json';

const lang = 'es';
---

<Layout
  lang={lang}
  title="Vocabulario 1.500"
  description="1.500 entradas de vocabulario Simpli de alta frecuencia con traducción al español."
>
  <h1>Vocabulario 1.500</h1>
  <p>
    Esta lista contiene 1.500 entradas frecuentes generadas con el flujo Simpli basado en
    pronunciación (pronunciación CMU a ortografía Simpli), con glosas en español.
  </p>
  <p><strong>Total de entradas:</strong> {vocabulary1500Es.length}</p>
  <p>
    <label for="vocab-search"><strong>Buscar:</strong></label>
    <input id="vocab-search" type="search" placeholder="Escribe español o Simpli..." autocomplete="off" />
  </p>

  <table id="vocab-table">
    <thead>
      <tr>
        <th>Español</th>
        <th>Simpli</th>
      </tr>
    </thead>
    <tbody>
      {vocabulary1500Es.map((entry) => (
        <tr>
          <td>{entry.translation}</td>
          <td><code>{entry.simpli}</code></td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>

<script>
  const input = document.querySelector('#vocab-search');
  const table = document.querySelector('#vocab-table');
  const rows = Array.from(table?.querySelectorAll('tbody tr') ?? []);

  if (input && rows.length > 0) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const row of rows) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.style.display = q === '' || text.includes(q) ? '' : 'none';
      }
    });
  }
</script>
