---
import Layout from '@/layouts/Base.astro';
import vocabulary5000Es from '@/data/vocabulary-5000.es.json';

const lang = 'es';
const t = (await import('../../translations/es.json')).default;
const vp = t.vocabularyListPage;
---

<Layout
  lang={lang}
  title="Vocabulario 5.000"
  description="5.000 entradas de vocabulario Simpli de alta frecuencia con traducción al español."
>
  <h1>Vocabulario 5.000</h1>
  <p>
    Esta lista amplía la tabla de 1.500 palabras con más raíces inglesas frecuentes en ortografía
    Simpli. Usa la búsqueda para palabras como <em>evil</em> que no están en la lista pequeña.
  </p>
  <p><strong>Total de entradas:</strong> {vocabulary5000Es.length}</p>
  <p class="downloads">
    <strong>{vp.downloadsHeading}:</strong>{' '}
    <a href="/es/vocabulary-5000.json" download="simpli-vocabulary-5000-es.json">{vp.jsonLink}</a>
    {' · '}
    <a href="/es/vocabulary-5000.csv" download="simpli-vocabulary-5000-es.csv">{vp.csvLink}</a>
    <span class="downloads-hint"> — {vp.downloadsHint}</span>
  </p>
  <p>
    <a href="/es/vocabulary-1500">← Lista de 1.500 palabras</a>
    {' · '}
    <a href="/es/tools">Herramienta de búsqueda</a>
  </p>
  <p>
    <label for="vocab-search"><strong>Buscar:</strong></label>
    <input id="vocab-search" type="search" placeholder="Escribe Simpli o español..." autocomplete="off" />
  </p>

  <table id="vocab-table">
    <thead>
      <tr>
        <th>Simpli</th>
        <th>Español</th>
      </tr>
    </thead>
    <tbody>
      {vocabulary5000Es.map((entry) => (
        <tr>
          <td><code>{entry.simpli}</code></td>
          <td>{entry.translation}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>

<script>
  const input = document.querySelector('#vocab-search');
  const table = document.querySelector('#vocab-table');
  const rows = Array.from(table?.querySelectorAll('tbody tr') ?? []);

  if (input && rows.length > 0) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const row of rows) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.style.display = q === '' || text.includes(q) ? '' : 'none';
      }
    });
  }
</script>

<style>
  .downloads-hint {
    font-size: 0.9rem;
    color: var(--color-text-muted, #555);
  }
</style>
