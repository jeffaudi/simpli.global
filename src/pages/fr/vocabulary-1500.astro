---
import Layout from '@/layouts/Base.astro';
import vocabulary1500Fr from '@/data/vocabulary-1500.fr.json';

const lang = 'fr';
const t = (await import('../../translations/fr.json')).default;
const vp = t.vocabulary1500Page;
---

<Layout
  lang={lang}
  title="Vocabulaire 1 500"
  description="1 500 entrées de vocabulaire Simpli à haute fréquence avec traduction française."
>
  <h1>Vocabulaire 1 500</h1>
  <p>
    Cette liste contient 1 500 entrées fréquentes générées avec le workflow Simpli fondé sur la
    prononciation (prononciation CMU vers orthographe Simpli), avec glosses en français.
  </p>
  <p><strong>Nombre d’entrées :</strong> {vocabulary1500Fr.length}</p>
  <p class="downloads">
    <strong>{vp.downloadsHeading} :</strong>{' '}
    <a href="/fr/vocabulary-1500.json" download="simpli-vocabulary-1500-fr.json">{vp.jsonLink}</a>
    {' · '}
    <a href="/fr/vocabulary-1500.csv" download="simpli-vocabulary-1500-fr.csv">{vp.csvLink}</a>
    <span class="downloads-hint"> — {vp.downloadsHint}</span>
  </p>
  <p>
    <label for="vocab-search"><strong>Recherche :</strong></label>
    <input id="vocab-search" type="search" placeholder="Saisir français ou Simpli..." autocomplete="off" />
  </p>

  <table id="vocab-table">
    <thead>
      <tr>
        <th>Français</th>
        <th>Simpli</th>
      </tr>
    </thead>
    <tbody>
      {vocabulary1500Fr.map((entry) => (
        <tr>
          <td>{entry.translation}</td>
          <td><code>{entry.simpli}</code></td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>

<script>
  const input = document.querySelector('#vocab-search');
  const table = document.querySelector('#vocab-table');
  const rows = Array.from(table?.querySelectorAll('tbody tr') ?? []);

  if (input && rows.length > 0) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const row of rows) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.style.display = q === '' || text.includes(q) ? '' : 'none';
      }
    });
  }
</script>

<style>
  .downloads-hint {
    font-size: 0.9rem;
    color: var(--color-text-muted, #555);
  }
</style>
