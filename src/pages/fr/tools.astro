---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = 'fr';
const t = (await import('../../translations/fr.json')).default;
const tp = t.toolsPage;
const ui = {
  lookupPlaceholder: tp.lookupPlaceholder,
  lookupLoading: tp.lookupLoading,
  lookupError: tp.lookupError,
  lookupNoResults: tp.lookupNoResults,
  lookupResults: tp.lookupResults,
};
---

<Layout lang={lang} title={tp.title} description={tp.metaDescription}>
  <h1>{tp.title}</h1>
  <p>{tp.intro}</p>

  <section class="card">
    <h2>{tp.lookupHeading}</h2>
    <p class="hint">{tp.lookupHint}</p>
    <p id="tools-status" class="status" aria-live="polite">{tp.lookupLoading}</p>
    <p>
      <label for="tools-q" class="visually-hidden">{tp.lookupPlaceholder}</label>
      <input id="tools-q" type="search" class="tools-input" placeholder={tp.lookupPlaceholder} autocomplete="off" />
    </p>
    <div id="tools-out" class="tools-out" />
  </section>

  <nav class="tools-nav" aria-label="Pages liées">
    <ul>
      <li><a href={getRelativeLocaleUrl(lang, 'vocabulary-5000')}>{tp.linkVocab5000}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'vocabulary-1500')}>{tp.linkVocab1500}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'spelling')}>{tp.linkSpelling}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'essential-words')}>{tp.linkEssential}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'lessons')}>{t.nav.lessons}</a></li>
    </ul>
  </nav>
</Layout>

<script define:vars={{ ui }}>
  (function () {
    var statusEl = document.getElementById('tools-status');
    var input = document.getElementById('tools-q');
    var out = document.getElementById('tools-out');
    if (!statusEl || !input || !out) return;

    var base = window.location.pathname.replace(/\/?tools\/?$/, '').replace(/\/$/, '');
    var jsonUrl = base + '/vocabulary-5000.json';
    var rows = [];

    function gloss(e) {
      return e.english != null ? e.english : e.translation != null ? e.translation : '';
    }

    function render() {
      if (!rows.length) return;
      var q = (input.value || '').trim().toLowerCase();
      if (q.length === 0) {
        out.innerHTML = '';
        return;
      }
      var hits = [];
      for (var i = 0; i < rows.length; i++) {
        var e = rows[i];
        var s = (e.simpli && e.simpli.toLowerCase()) || '';
        var g = gloss(e).toLowerCase();
        if (s.indexOf(q) !== -1 || g.indexOf(q) !== -1) hits.push(e);
        if (hits.length >= 100) break;
      }
      if (hits.length === 0) {
        out.innerHTML = '<p class="muted">' + ui.lookupNoResults + '</p>';
        return;
      }
      var gLabel = rows[0] && rows[0].english != null ? 'English' : 'Français';
      var html = '<p><strong>' + ui.lookupResults + ' (' + hits.length + ')</strong></p><table class="tools-table"><thead><tr><th>Simpli</th><th>' + gLabel + '</th></tr></thead><tbody>';
      for (var j = 0; j < hits.length; j++) {
        var h = hits[j];
        html += '<tr><td><code>' + String(h.simpli) + '</code></td><td>' + String(gloss(h)) + '</td></tr>';
      }
      html += '</tbody></table>';
      out.innerHTML = html;
    }

    fetch(jsonUrl)
      .then(function (r) {
        if (!r.ok) throw new Error();
        return r.json();
      })
      .then(function (data) {
        rows = data;
        statusEl.textContent = '';
        input.addEventListener('input', render);
      })
      .catch(function () {
        statusEl.textContent = ui.lookupError;
      });
  })();
</script>

<style>
  .hint {
    font-size: 0.95rem;
    color: var(--color-text-muted, #555);
  }
  .status {
    min-height: 1.25em;
  }
  .tools-input {
    width: 100%;
    max-width: 28rem;
    padding: 0.45em 0.65em;
    font-size: 1rem;
  }
  .tools-out {
    margin-top: 1em;
    overflow-x: auto;
  }
  .tools-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .tools-table th,
  .tools-table td {
    border: 1px solid color-mix(in srgb, var(--color-text, #111) 18%, transparent);
    padding: 0.35em 0.5em;
    text-align: left;
  }
  .muted {
    color: var(--color-text-muted, #555);
  }
  .tools-nav ul {
    list-style: disc;
    padding-left: 1.25em;
    margin-top: 1.5em;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
