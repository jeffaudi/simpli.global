---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = 'fr';
const t = (await import('../../translations/fr.json')).default;
---

<Layout lang={lang} title={t.nav.specification} description="Spécification officielle du Simpli : alphabet, orthographe, grammaire, vocabulaire.">
  <h1>{t.nav.specification}</h1>
  <p>
    Cette page donne accès à la <strong>spécification complète, archivée et numérotée</strong> de Simpli (pour
    la citation et la conservation). Téléchargez le PDF ci-dessous.
  </p>

  <h2>Version</h2>
  <p><strong>Simpli v0.1</strong> (spécification en projet).</p>

  <h2>Téléchargements</h2>
  <ul>
    <li>
      <a href="/spec/simpli-specification-v0.1.pdf" download>PDF : simpli-specification-v0.1.pdf</a>
    </li>
    <li>
      <a href="/spec/simpli-specification-v0.1.md" download>Source (Markdown) : simpli-specification-v0.1.md</a>
    </li>
  </ul>

  <h2>Pages “vivantes” (non archivées)</h2>
  <p>
    Sur le site, le même contenu existe aussi sous forme de pages qui peuvent évoluer :
    <a href={getRelativeLocaleUrl(lang, 'spelling')}>Orthographe</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'grammar-rules')}>Règles de grammaire</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'vocabulary')}>Vocabulaire</a>
  </p>
</Layout>

<style>
  ul { padding-left: 1.25em; list-style: disc; margin: 0.5em 0 1em; }
  h2 { margin-top: 1.25em; }
</style>
