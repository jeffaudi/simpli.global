---
import Layout from '@/layouts/Base.astro';
import NextStepsContent from '@/components/NextStepsContent.astro';
const lang = 'fr';
const t = (await import('../../translations/fr.json')).default;
const p = t.nextStepsPage;
---

<Layout lang={lang} title={t.nav.nextSteps} description={p.metaDescription}>
  <h1>{t.nav.nextSteps}</h1>
  <p>{p.intro}</p>
  <NextStepsContent lang="fr" />
</Layout>
