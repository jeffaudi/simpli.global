---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = 'en';
const t = (await import('../../translations/en.json')).default;
---

<Layout lang={lang} title={t.nav.specification} description="Official Simpli language specification: alphabet, spelling, grammar, vocabulary.">
  <h1>{t.nav.specification}</h1>
  <p>
    This page links to the <strong>full, archived, numbered</strong> Simpli specification (for citation and
    long-term reference). Download the PDF below.
  </p>

  <h2>Version</h2>
  <p><strong>Simpli v0.1</strong> (draft specification).</p>

  <h2>Downloads</h2>
  <ul>
    <li>
      <a href="/spec/simpli-specification-v0.1.pdf" download>PDF: simpli-specification-v0.1.pdf</a>
    </li>
    <li>
      <a href="/spec/simpli-specification-v0.1.md" download>Source (Markdown): simpli-specification-v0.1.md</a>
    </li>
  </ul>

  <h2>Living pages (non-archived)</h2>
  <p>
    The site also keeps the same material split into pages that may evolve over time:
    <a href={getRelativeLocaleUrl(lang, 'spelling')}>Spelling</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'grammar-rules')}>Grammar rules</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'vocabulary')}>Vocabulary</a>
  </p>
</Layout>

<style>
  ul { padding-left: 1.25em; list-style: disc; margin: 0.5em 0 1em; }
  h2 { margin-top: 1.25em; }
</style>
