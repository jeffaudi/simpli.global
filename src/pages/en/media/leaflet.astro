---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { dialogueExample } from '@/data/simpli-examples';

const lang = 'en';
const t = (await import('../../../translations/en.json')).default;
const lp = t.leafletPrint;
---

<Layout lang={lang} title={lp.title} description={t.mediaPage.leafletDesc}>
  <article class="leaflet-sheet">
    <h1 dir="ltr">{lp.title}</h1>
    <p class="leaflet-tagline">{lp.tagline}</p>
    <p class="leaflet-bullets">{lp.bullets}</p>

    <h2>{lp.exampleTitle}</h2>
    <pre class="simpli-block" dir="ltr">{dialogueExample}</pre>
    <p class="gloss">{lp.exampleGloss}</p>

    <p class="footer-line">
      <strong>{lp.learnMore}</strong>{' '}
      <span dir="ltr">{lp.url}</span>
    </p>
    <p class="back">
      <a href={getRelativeLocaleUrl(lang, 'media')}>← {t.nav.media}</a>
    </p>
  </article>
</Layout>

<style>
  .leaflet-sheet {
    max-width: 40rem;
    margin: 0 auto;
  }
  .leaflet-tagline {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-theme);
  }
  .leaflet-bullets {
    line-height: 1.5;
  }
  .gloss {
    font-size: 0.95rem;
    color: var(--color-text-muted, #555);
    font-style: italic;
  }
  .footer-line {
    margin-top: 2em;
    font-size: 1.1rem;
  }
  .back {
    margin-top: 2em;
  }
</style>

<style is:global>
  @media print {
    header.l-header,
    footer.l-footer,
    #js-languageSuggest {
      display: none !important;
    }
    main.l-main {
      padding-top: 0 !important;
    }
    .leaflet-sheet .back {
      display: none;
    }
  }
</style>
