---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { motivationContent } from '@/data/motivation-content';
const lang = 'en';
const t = (await import('../../translations/en.json')).default;
const c = motivationContent[lang];
const m = t.motivationPage;
---

<Layout lang={lang} title={t.nav.motivation} description={m.metaDescription}>
  <h1>{t.nav.motivation}</h1>
  <p>{c.intro}</p>
  <h2>Positioning statement</h2>
  <blockquote>
    Simpli is a next-generation auxiliary language combining English vocabulary with Indonesian-style grammar to achieve maximum simplicity without sacrificing expressiveness.
  </blockquote>
  <p>{m.barriersHeading}</p>
  <ul>
    <li><strong>{c.time}</strong></li>
    <li><strong>{c.complexity}</strong></li>
    <li><strong>{c.neutrality}</strong></li>
    <li><strong>{c.pronunciation}</strong></li>
  </ul>
  <p>{c.bridge}</p>

  <h2>Strategic positioning</h2>
  <p>Where Simpli wins clearly:</p>
  <ul>
    <li><strong>Grammar simplicity:</strong> best in class.</li>
    <li><strong>Learning speed:</strong> basics can be acquired quickly.</li>
    <li><strong>Potential global familiarity:</strong> English-rooted vocabulary supports recognition.</li>
  </ul>

  <h2>Scalability notes</h2>
  <p>Simpli has strong potential to become a real language if:</p>
  <ul>
    <li>the grammar is complete, not only minimal,</li>
    <li>the rules remain closed and stable,</li>
    <li>the community can extend vocabulary coherently.</li>
  </ul>
  <p>
    <a href={getRelativeLocaleUrl(lang, 'roots')}>{m.linkRoots}</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'comparison')}>{m.linkComparison}</a>
  </p>
</Layout>

<style>
  ul { padding-left: 1.25em; list-style: disc; margin: 0.5em 0 1em; }
</style>
