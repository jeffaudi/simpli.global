---
import Layout from '@/layouts/Base.astro';
import { vocabulary1500 } from '@/data/vocabulary-1500';

const lang = 'en';
const t = (await import('../../translations/en.json')).default;
const vp = t.vocabulary1500Page;
---

<Layout
  lang={lang}
  title="Vocabulary 1,500"
  description="1,500 high-frequency Simpli vocabulary entries with English translation."
>
  <h1>Vocabulary 1,500</h1>
  <p>
    This list contains 1,500 high-frequency entries generated with the Simpli pronunciation-first
    workflow (CMU pronunciation to Simpli spelling), with English glosses for the English website.
  </p>
  <p><strong>Total entries:</strong> {vocabulary1500.length}</p>
  <p class="downloads">
    <strong>{vp.downloadsHeading}:</strong>{' '}
    <a href="/en/vocabulary-1500.json" download="simpli-vocabulary-1500-en.json">{vp.jsonLink}</a>
    {' · '}
    <a href="/en/vocabulary-1500.csv" download="simpli-vocabulary-1500-en.csv">{vp.csvLink}</a>
    <span class="downloads-hint"> — {vp.downloadsHint}</span>
  </p>
  <p>
    <label for="vocab-search"><strong>Search:</strong></label>
    <input id="vocab-search" type="search" placeholder="Type English or Simpli..." autocomplete="off" />
  </p>

  <table id="vocab-table">
    <thead>
      <tr>
        <th>English</th>
        <th>Simpli</th>
      </tr>
    </thead>
    <tbody>
      {vocabulary1500.map((entry) => (
        <tr>
          <td>{entry.english}</td>
          <td><code>{entry.simpli}</code></td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>

<script>
  const input = document.querySelector('#vocab-search');
  const table = document.querySelector('#vocab-table');
  const rows = Array.from(table?.querySelectorAll('tbody tr') ?? []);

  if (input && rows.length > 0) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const row of rows) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.style.display = q === '' || text.includes(q) ? '' : 'none';
      }
    });
  }
</script>

<style>
  .downloads-hint {
    font-size: 0.9rem;
    color: var(--color-text-muted, #555);
  }
</style>
