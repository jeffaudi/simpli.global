---
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = 'en';
const t = (await import('../../translations/en.json')).default;
---

<Layout lang={lang} title={t.nav.roots} description={t.pages.roots.metaDescription}>
  <h1>{t.nav.roots}</h1>
  <p set:html={t.pages.roots.leadP} />
  <h2>{t.pages.roots.grammarH2}</h2>
  <p set:html={t.pages.roots.grammarP} />
  <h2>{t.pages.roots.vocabularyH2}</h2>
  <p set:html={t.pages.roots.vocabularyP} />
  <h2>{t.pages.roots.spellingH2}</h2>
  <p set:html={t.pages.roots.spellingP} />
  <h2>{t.pages.roots.whyH2}</h2>
  <p>{t.pages.roots.whyP}</p>
  <p>
    <a href={getRelativeLocaleUrl(lang, 'grammar')}>{t.pages.roots.linkGrammar}</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'vocabulary')}>{t.pages.roots.linkVocabulary}</a>
  </p>
</Layout>
