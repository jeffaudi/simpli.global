---
import { getTranslations } from '@/lib/translations';
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeParams, type Lang } from '@/i18n';

export function getStaticPaths() {
  return localeParams;
}

const lang = (Astro.props.lang ?? Astro.params.locale ?? Astro.currentLocale ?? 'en') as Lang;
const t = getTranslations(lang);
const c = t.motivation as Record<string, string>;
const m = t.motivationPage as Record<string, string>;
---

<Layout lang={lang} title={t.nav.motivation} description={m.metaDescription}>
  <h1>{t.nav.motivation}</h1>
  <p>{c.intro}</p>
  <h2>{m.positioningHeading}</h2>
  <blockquote>{c.positioningQuote}</blockquote>
  <p>{c.notSimplifiedEnglish}</p>
  <p>{m.barriersHeading}</p>
  <ul>
    <li><strong>{c.time}</strong></li>
    <li><strong>{c.complexity}</strong></li>
    <li><strong>{c.neutrality}</strong></li>
    <li><strong>{c.pronunciation}</strong></li>
  </ul>
  <p>{c.bridge}</p>

  <h2>{c.strategicHeading}</h2>
  <p>{c.strategicIntro}</p>
  <ul>
    <li><strong>{c.strategicGrammar}</strong></li>
    <li><strong>{c.strategicLearning}</strong></li>
    <li><strong>{c.strategicFamiliarity}</strong></li>
  </ul>

  <h2>{c.scalabilityHeading}</h2>
  <p>{c.scalabilityIntro}</p>
  <ul>
    <li>{c.scalabilityGrammar}</li>
    <li>{c.scalabilityRules}</li>
    <li>{c.scalabilityCommunity}</li>
  </ul>
  <p><strong>{c.scalabilityRisk}</strong></p>
  <p>
    <a href={getRelativeLocaleUrl(lang, 'roots')}>{m.linkRoots}</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'comparison')}>{m.linkComparison}</a>
  </p>
</Layout>

<style>
  ul { padding-left: 1.25em; list-style: disc; margin: 0.5em 0 1em; }
</style>
