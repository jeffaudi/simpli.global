---
import { getTranslations } from '@/lib/translations';
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { renderPedagogy, type PedagogyNode } from '@/lib/pedagogy';
import structure from '@/data/pedagogy-structure.json';
import { localeParams, type Lang } from '@/i18n';

export function getStaticPaths() {
  return localeParams;
}

const lang = (Astro.props.lang ?? Astro.params.locale ?? Astro.currentLocale ?? 'en') as Lang;
const t = getTranslations(lang) as {
  nav: { spelling: string };
  pages: {
    alphabetRationale: { h1: string; metaDescription: string } & Record<string, string>;
  };
};
const page = t.pages.alphabetRationale;
const html = renderPedagogy(
  structure.alphabetRationale as PedagogyNode[],
  page,
  lang,
  'spelling/alphabet-rationale',
);
---

<Layout lang={lang} title={page.h1} description={page.metaDescription}>
  <h1>{page.h1}</h1>
  <p><a href={getRelativeLocaleUrl(lang, 'spelling')}>← {t.nav.spelling}</a></p>
  <article class="page-markdown" set:html={html} />
</Layout>

<style>
  .page-markdown :global(ul) {
    padding-inline-start: 1.25em;
    list-style: disc;
    margin: 0.5em 0 1em;
  }
</style>
