---
import { getTranslations } from '@/lib/translations';
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeParams, type Lang } from '@/i18n';

export function getStaticPaths() {
  return localeParams;
}

const lang = (Astro.props.lang ?? Astro.params.locale ?? Astro.currentLocale ?? 'en') as Lang;
const t = getTranslations(lang);
const m = t.mediaPage;
const leafletHref = getRelativeLocaleUrl(lang, 'media/leaflet');
---

<Layout lang={lang} title={m.title} description={m.metaDescription}>
  <h1>{m.title}</h1>
  <p>{m.intro}</p>

  <section class="card">
    <h2>{m.leafletHeading}</h2>
    <p>{m.leafletDesc}</p>
    <p><a href={leafletHref}>{m.leafletLink}</a></p>
  </section>

  <section class="card">
    <h2>{m.visualsHeading}</h2>
    <p>{m.visualsDesc}</p>
    <p>
      <a href="/media/share-simpli.svg" download="simpli-share-card.svg">share-simpli.svg</a>
      {' '}(<code>/media/share-simpli.svg</code>)
    </p>
  </section>

  <section class="card">
    <h2>{m.governanceHeading}</h2>
    <p>{m.governanceBody}</p>
    <p>
      <a href={getRelativeLocaleUrl(lang, 'discussion')}>{m.linkDiscussion}</a>
    </p>
  </section>
</Layout>
