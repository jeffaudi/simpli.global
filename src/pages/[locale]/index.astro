---
import { getTranslations } from '@/lib/translations';
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeParams, type Lang } from '@/i18n';

export function getStaticPaths() {
  return localeParams;
}

const lang = (Astro.props.lang ?? Astro.params.locale ?? Astro.currentLocale ?? 'en') as Lang;
const t = getTranslations(lang);

const nextStepsBase = getRelativeLocaleUrl(lang, 'next-steps');
---

<Layout lang={lang}>
  <h1>{t.home.hero}</h1>
  <p>{t.home.concept1}</p>
  <p>{t.home.concept2}</p>

  <section class="learn-path-banner card">
    <h2>{t.home.startLearningTitle}</h2>
    <p>{t.home.startLearningIntro}</p>
    <p class="learn-path-steps">
      <a href={getRelativeLocaleUrl(lang, 'lessons')}>{t.nav.lessons}</a>
      <span class="arrow" aria-hidden="true">→</span>
      <a href={getRelativeLocaleUrl(lang, 'tools')}>{t.nav.tools}</a>
      <span class="arrow" aria-hidden="true">→</span>
      <a href={getRelativeLocaleUrl(lang, 'samples')}>{t.nav.samples}</a>
    </p>
  </section>

  <h2>{t.home.conceptLinks}</h2>
  <div class="card-grid">
    <a href={getRelativeLocaleUrl(lang, 'motivation')} class="card">
      <h3>{t.nav.motivation}</h3>
      <p>{t.home.cardMotivation}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'roots')} class="card">
      <h3>{t.nav.roots}</h3>
      <p>{t.home.cardRoots}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'grammar')} class="card">
      <h3>{t.nav.grammar}</h3>
      <p>{t.home.cardGrammar}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'vocabulary')} class="card">
      <h3>{t.nav.vocabulary}</h3>
      <p>{t.home.cardVocabulary}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'spelling')} class="card">
      <h3>{t.nav.spelling}</h3>
      <p>{t.home.cardSpelling}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'comparison')} class="card">
      <h3>{t.nav.comparison}</h3>
      <p>{t.home.cardComparison}</p>
    </a>
    <a href={getRelativeLocaleUrl(lang, 'samples')} class="card">
      <h3>{t.nav.samples}</h3>
      <p>{t.home.cardSamples}</p>
    </a>
  </div>

  <h2>{t.home.nextStepsTitle}</h2>
  <div class="next-steps-grid">
    <a href={getRelativeLocaleUrl(lang, 'discussion')} class="card">
      <h3>{t.nav.discussionTopics}</h3>
      <p>{t.home.cardDiscussion}</p>
    </a>
    <a href={`${nextStepsBase}#interact`} class="card">
      <h3>{t.home.interact}</h3>
      <p>{t.home.interactDesc}</p>
    </a>
    <a href={`${nextStepsBase}#learn`} class="card">
      <h3>{t.home.learn}</h3>
      <p>{t.home.learnDesc}</p>
    </a>
    <a href={`${nextStepsBase}#promote`} class="card">
      <h3>{t.home.promote}</h3>
      <p>{t.home.promoteDesc}</p>
    </a>
  </div>
</Layout>

<style>
  .learn-path-banner {
    margin: 1.5em 0;
  }

  .learn-path-banner h2 {
    margin-top: 0;
  }

  .learn-path-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em 0.5em;
    margin: 0.75em 0 0;
    font-weight: 600;
  }

  .learn-path-steps a {
    color: var(--color-theme);
  }

  .arrow {
    opacity: 0.6;
  }
</style>
