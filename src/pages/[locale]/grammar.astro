---
import { getTranslations } from '@/lib/translations';
import Layout from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeParams, type Lang } from '@/i18n';

export function getStaticPaths() {
  return localeParams;
}

const lang = (Astro.props.lang ?? Astro.params.locale ?? Astro.currentLocale ?? 'en') as Lang;
const t = getTranslations(lang);
---

<Layout lang={lang} title={t.nav.grammar} description={t.pages.grammar.metaDescription}>
  <h1>{t.nav.grammar}</h1>
  <p set:html={t.grammarOverview.lead} />
  <ul>
    <li set:html={t.grammarOverview.bulletPronouns} />
    <li set:html={t.grammarOverview.bulletWordOrder} />
    <li set:html={t.grammarOverview.bulletVerbs} />
    <li set:html={t.grammarOverview.bulletPossession} />
    <li set:html={t.grammarOverview.bulletPlurals} />
    <li set:html={t.grammarOverview.bulletQuestions} />
    <li>
      <strong>{t.grammarPage.numbersBulletTitle}</strong>
      {' '}
      {t.grammarPage.numbersBulletBody}{' '}
      <a href={getRelativeLocaleUrl(lang, 'numbers-dates-time')}>{t.grammarPage.numbersBulletLink}</a>
    </li>
  </ul>
  <p><a href={getRelativeLocaleUrl(lang, 'grammar-rules')}>{t.grammarOverview.fullListLink}</a></p>
</Layout>

<style>
  ul { padding-left: 1.25em; list-style: disc; margin: 0.5em 0 1em; }
</style>
