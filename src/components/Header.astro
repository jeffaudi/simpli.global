---
// Header & nav – Simpli (from Astro i18n Starter)
import LocaleSelect from '@/components/i18n/LocaleSelect.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '@/i18n';

interface Props {
  t: { nav: Record<string, string>; languageSwitcher: string };
}

const { t } = Astro.props;
const locale = Astro.currentLocale as Lang;

const isActive = (path: string) => {
  const href = getRelativeLocaleUrl(locale, path);
  if (path === '/') {
    return Astro.url.pathname === href;
  }
  return Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
};

type NavItem = { path: string; key: string };

const navGroups: { groupKey: string; items: NavItem[] }[] = [
  {
    groupKey: 'groupAbout',
    items: [
      { path: '/motivation', key: 'motivation' },
      { path: '/roots', key: 'roots' },
      { path: '/comparison', key: 'comparison' },
      { path: '/samples', key: 'samples' },
    ],
  },
  {
    groupKey: 'groupLearn',
    items: [
      { path: '/lessons', key: 'lessons' },
      { path: '/tools', key: 'tools' },
      { path: '/vocabulary', key: 'vocabulary' },
      { path: '/media', key: 'media' },
    ],
  },
  {
    groupKey: 'groupReference',
    items: [
      { path: '/grammar', key: 'grammar' },
      { path: '/spelling', key: 'spelling' },
      { path: '/numbers-dates-time', key: 'numbersDatesTime' },
      { path: '/specification', key: 'specification' },
    ],
  },
  {
    groupKey: 'groupCommunity',
    items: [
      { path: '/discussion', key: 'discussionTopics' },
      { path: '/next-steps', key: 'nextSteps' },
    ],
  },
];
---

<header class="l-header">
  <h1 dir="ltr">
    <a href={getRelativeLocaleUrl(locale, '/')}>Simpli</a>
  </h1>

  <LocaleSelect />

  <nav class="l-content" aria-label="Main">
    <ul class="nav-home">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, '/')}
          class:list={[isActive('/') && 'active']}
        >
          {t.nav.home ?? 'Home'}
        </a>
      </li>
    </ul>
    {
      navGroups.map(({ groupKey, items }) => (
        <div class="nav-group">
          <span class="nav-group-label">{t.nav[groupKey] ?? groupKey}</span>
          <ul>
            {items.map(({ path, key }) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, path)}
                  class:list={[isActive(path) && 'active']}
                >
                  {t.nav[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</header>

<style>
  header {
    display: grid;
    place-items: center;
    gap: var(--sp-s);
  }

  h1 {
    margin-block-start: var(--sp-l);
    font-size: 2rem;
    font-weight: 800;
  }

  h1 a {
    color: var(--color-theme);
  }

  @media (width < 480px) {
    h1 {
      font-size: 1.5rem;
    }
  }

  nav {
    width: 100%;
    max-width: 52rem;
  }

  .nav-home {
    display: flex;
    justify-content: center;
    margin-block-start: var(--sp-s);
    padding: 0;
    list-style: none;
  }

  .nav-group {
    margin-block-start: var(--sp-s);
  }

  .nav-group-label {
    display: block;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #666);
    margin-block-end: 0.25em;
  }

  .nav-group ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 1rem;
    font-weight: 600;
    padding: 0.25em 0.5em;
    border-radius: 4px;
  }

  nav a:hover,
  nav a:active {
    background-color: color-mix(in srgb, var(--color-theme) 12%, transparent);
  }

  nav a.active {
    color: var(--color-theme);
    pointer-events: none;
  }
</style>
