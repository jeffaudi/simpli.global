---
import { getLocalePaths, LOCALES } from '@/i18n';
import { LOCALE_REGION_LABELS } from '@/locales';
import type { Lang } from '@/i18n';

const regions = ['europe', 'east-asia', 'southeast-asia'] as const;
const pathsByLang = new Map(getLocalePaths(Astro.url).map((p) => [p.lang, p.path]));
---

<label>
  <span class="material-icons-sharp" aria-hidden="true">translate</span>
  <select data-languageSelect>
    {
      regions.map((region) => (
        <optgroup label={LOCALE_REGION_LABELS[region]}>
          {Object.entries(LOCALES)
            .filter(([, cfg]) => cfg.region === region)
            .map(([lang, cfg]) => (
              <option
                label={cfg.label}
                value={pathsByLang.get(lang as Lang)}
                data-lang={lang}
                selected={lang === Astro.currentLocale}
                dir={cfg.dir || null}
              />
            ))}
        </optgroup>
      ))
    }
  </select>
  <span class="material-icons-sharp" aria-hidden="true">expand_more</span>
</label>

<script is:inline>
  document.querySelectorAll('[data-languageSelect]').forEach((select) => {
    select.addEventListener('change', (event) => {
      const opt = event.target?.selectedOptions?.[0];
      if (opt?.dataset?.lang) localStorage.selectedLang = opt.dataset.lang;
      if (opt?.value) location.href = opt.value;
    });
  });
</script>

<style>
  label {
    position: relative;
    display: inline-block;
    width: min(100%, 280px);
    text-align-last: left;
  }
  .material-icons-sharp {
    pointer-events: none;
    position: absolute;
    color: var(--color-theme);
    font-size: 20px;
  }
  .material-icons-sharp:first-child {
    inset: 10px auto 10px 10px;
    opacity: 0.5;
  }
  .material-icons-sharp:last-child {
    inset: 8px 8px 8px auto;
  }
  select {
    width: 100%;
    height: 40px;
    padding-inline: 36px;
    cursor: pointer;
    appearance: none;
    border-radius: 6px;
    font-family: inherit;
    color: var(--color-main);
    background-color: var(--color-base);
    border: 2px solid var(--color-theme);
  }
</style>
