---
import type { Lang } from '@/i18n';
import { LOCALES } from '@/i18n';
import { fontStackForScript, googleFontUrlForScript } from '@/lib/fonts';

const locale = Astro.currentLocale as Lang;
const script = LOCALES[locale]?.script ?? 'latin';
const fontFamily = fontStackForScript(script);
const fontUrl = googleFontUrlForScript(script);
---
<link rel="stylesheet" href={fontUrl} />
<style is:global set:html={`body { font-family: ${fontFamily}; }`}></style>
