---
// Footer – Simpli (from Astro i18n Starter)
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '@/i18n';

interface Props {
  t: {
    nav: Record<string, string>;
    footer: {
      licenseBefore: string;
      licenseLinkLabel: string;
      licenseAfter: string;
    };
  };
  locale: Lang;
  siteTitle?: string;
}

const {
  t,
  locale,
  siteTitle = 'Simpli is a simple international language',
} = Astro.props;
---

<footer class="l-footer l-content">
  <a href={getRelativeLocaleUrl(locale, '/')} class="brand">Simpli</a>
  <p class="tagline">{siteTitle}</p>
  <p class="license" dir="ltr">
    {t.footer.licenseBefore}{' '}
    <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">{t.footer.licenseLinkLabel}</a>{' '}
    {t.footer.licenseAfter}
  </p>
</footer>

<style>
  footer {
    padding-block: var(--sp-m) var(--sp-l);
    text-align: center;
    background-color: var(--color-theme);
    color: var(--color-base);
    border-radius: 16px;
    margin-block-end: -16px;
  }

  .brand {
    display: block;
    font-weight: 700;
    color: var(--color-base);
    margin-block-end: var(--sp-s);
  }

  .tagline {
    margin: 0;
    opacity: 0.95;
  }

  .license {
    margin: var(--sp-m) 0 0;
    font-size: 0.9em;
    opacity: 0.9;
  }

  .license a {
    color: inherit;
    text-decoration: underline;
  }
</style>
