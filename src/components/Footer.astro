---
// Footer – Simpli (from Astro i18n Starter)
interface Props {
  t: { nav: Record<string, string> };
  siteTitle?: string;
}

const { t, siteTitle = 'Learn to speak, read and write Simpli' } = Astro.props;
---

<footer class="l-footer l-content">
  <a href="/en/" class="brand">Simpli</a>
  <p class="tagline">{siteTitle}</p>
  <p class="license" dir="ltr">
    Content on this site is licensed under a <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">Creative Commons Attribution 4.0 International License</a> (CC BY 4.0).
  </p>
</footer>

<style>
  footer {
    padding-block: var(--sp-m) var(--sp-l);
    text-align: center;
    background-color: var(--color-theme);
    color: var(--color-base);
    border-radius: 16px;
    margin-block-end: -16px;
  }

  .brand {
    display: block;
    font-weight: 700;
    color: var(--color-base);
    margin-block-end: var(--sp-s);
  }

  .tagline {
    margin: 0;
    opacity: 0.95;
  }

  .license {
    margin: var(--sp-m) 0 0;
    font-size: 0.9em;
    opacity: 0.9;
  }

  .license a {
    color: inherit;
    text-decoration: underline;
  }
</style>
